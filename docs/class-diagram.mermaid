classDiagram
    class FavItem {
        <<interface 八类条目统一>>
        +boolean fav
    }
    class MoodItem {
        +string id
        +string type
        +string content
        +string tag
        +string[] tags
        +string[] autoTags
        +boolean fav
    }
    class Shot {
        +string id
        +string name
        +string date
        +string slot
        +number duration
        +string sceneId
        +string[] refIds
        +string note
        +boolean done
        +number ord
        +boolean fav
    }
    class Node {
        +string id
        +string type
        +string title
        +string start
        +string end
        +string note
        +string date
        +boolean done
        +boolean fav
    }
    class Scene {
        +string id
        +string name
        +string note
        +boolean done
        +boolean fav
    }
    class Item {
        +string id
        +string kind
        +string name
        +string note
        +boolean done
        +boolean fav
    }
    class Budget {
        +string id
        +string item
        +string cat
        +number amount
        +boolean paid
        +boolean fav
    }
    class Note {
        +string id
        +string kind
        +string content
        +number ts
        +boolean fav
    }
    class Todo {
        +string id
        +string title
        +string owner
        +string due
        +boolean done
        +boolean fav
    }
    class Project {
        +string id
        +string name
        +string client
        +string studio
        +string status
        +string shootDate
        +string location
        +string lat
        +string lng
        +number v3
        +boolean demo
        +number createdAt
        +number updatedAt
        +Concept concept
        +MoodItem[] mood
        +Shot[] shots
        +Node[] schedule
        +Scene[] scenes
        +Item[] items
        +Budget[] budget
        +Note[] notes
        +Todo[] todos
        +string[] tagVocab
    }
    class Concept {
        +string theme
        +string model
        +string style
        +string audience
        +string usage
        +string note
    }
    class ViewState {
        +string mode
        +string pid
        +string tab
        +string shotFilter
        +string boardQuery
        +string boardScope
        +string[] moodFilter
        +string moodFilterMode
        +Object shotDraft
        +string poseCat
        +string editingShotId
        +number replaceIdx
        +boolean allowDemoWrite
        +string editingNodeId
        +string editingStuffId
        +string editingStuffKey
        +string editingTodoId
        +string editingNoteId
        +Object refViewer
        +Object focusRef
    }
    class FavEntry {
        +string type
        +string pid
        +string id
        +string summary
        +string module
        +string date
    }
    class DemoSpec {
        +string status
        +string name
        +string theme
        +string[] art
        +boolean fullRefShot
        +number favIndex
    }
    class V9PureFunctions {
        <<module 纯函数层 可 vm 抽取>>
        +freshView(patch) ViewState
        +clearInlineEditState(v) ViewState
        +migrateFav(p) Project
        +isFav(it) boolean
        +favCount(list) number
        +favSummary(type, it) string
        +summary40(s) string
        +collectFavorites(projects) FavEntry[]
        +backupItemCount(projects) number
        +matchBoardScope(p, scope) boolean
        +isActiveStatus(p) boolean
        +parseMultiImage(e) File[]
        +slugPreview(label, palette) string
        +cloneDemo(p, newId, now) Project
        +demoSpecs() DemoSpec[]
        +buildDemoProject(spec, mkId, now) Project
    }
    class Persistence {
        <<module 状态层>>
        +loadP() Project[]
        +saveP(a) void
        +updateCur(fn) void
        +migrate(p) Project
        +initData() Promise
        +cacheProjectImages(p) Promise
        +idb Object
    }
    class DemoFactory {
        <<module 状态层>>
        +seed() void
        +ensureV9Demo() Promise
        +copyDemoToMine(pid) void
        +LS_DEMO_V9 string
    }
    class BoardRenderer {
        <<module 渲染层>>
        +renderBoard() void
        +renderFavorites() void
        +openFavorites() void
        +jumpToFav(type, pid, id) void
    }
    class ProjectRenderer {
        <<module 渲染层>>
        +renderProject() void
        +renderConcept(p) void
        +renderMood(p) void
        +renderMoodGrid(p) void
        +renderSchedule(p) void
        +timelineHtml(p, date) string
        +renderStuff(p) void
        +renderBudget(p) void
        +renderNotes(p) void
    }
    class ShotRenderer {
        <<module 渲染层>>
        +renderShots(p) Promise
        +addShotImg(e) Promise
        +toggleRef(id) void
        +openRefViewer(shotId, ri) void
        +refNav(delta) void
        +removeShotRef(shotId, idx) void
    }
    class EditHandlers {
        <<module 渲染层>>
        +beginInlineEdit(kind, id, key) void
        +cancelInlineEdit() boolean
        +saveNodeEdit(id) void
        +saveStuffEdit(key, id) void
        +saveTodoEdit(id) void
        +saveNoteEdit(id) void
        +toggleFav(type, id) void
    }
    class DocOutput {
        <<module 文档输出>>
        +openDoc(kind) void
        +exportProposalFile() void
        +exportJSON() Promise
        +exportProject(pid) Promise
    }
    FavItem <|.. MoodItem
    FavItem <|.. Shot
    FavItem <|.. Node
    FavItem <|.. Scene
    FavItem <|.. Item
    FavItem <|.. Budget
    FavItem <|.. Note
    FavItem <|.. Todo
    Project "1" *-- "1" Concept : concept
    Project "1" *-- "0..*" MoodItem : mood
    Project "1" *-- "0..*" Shot : shots
    Project "1" *-- "0..*" Node : schedule
    Project "1" *-- "0..*" Scene : scenes
    Project "1" *-- "0..*" Item : items
    Project "1" *-- "0..*" Budget : budget
    Project "1" *-- "0..*" Note : notes
    Project "1" *-- "0..*" Todo : todos
    Shot "1" o-- "0..3" MoodItem : refIds 指向 content
    ViewState ..> V9PureFunctions : freshView / clearInlineEditState
    Persistence ..> V9PureFunctions : migrateFav 挂钩 migrate
    Persistence ..> ViewState : updateCur 读取 allowDemoWrite
    DemoFactory ..> V9PureFunctions : slugPreview / buildDemoProject / cloneDemo
    DemoFactory ..> Persistence : saveP / idb.put
    BoardRenderer ..> V9PureFunctions : matchBoardScope / backupItemCount / collectFavorites
    BoardRenderer ..> Persistence : loadP
    ProjectRenderer ..> V9PureFunctions : isFav / favCount
    ProjectRenderer ..> Persistence : updateCur
    ShotRenderer ..> V9PureFunctions : parseMultiImage
    ShotRenderer ..> Persistence : updateCur / idb
    EditHandlers ..> V9PureFunctions : clearInlineEditState / isFav
    EditHandlers ..> Persistence : updateCur
    DocOutput ..> Persistence : loadP / imgCache
