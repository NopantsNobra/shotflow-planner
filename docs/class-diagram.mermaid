classDiagram
    %% ===== 瞬刻 Stillmark v10 · 数据模型与排程引擎 =====
    %% slot 由 planDay 派生并物化写回；dayItems / Call Sheet / 拍摄日 继续只读 slot

    class Project {
        +string id
        +string name
        +string shootDate
        +string status
        +Shot[] shots
        +ScheduleNode[] schedule
        +Scene[] scenes
        +string[] dayInit
        +string[] shootDates
        +boolean demo
        +migrate()
    }

    class Shot {
        +string id
        +string name
        +string date
        +string slot
        +number duration
        +string sceneId
        +string[] refIds
        +string position
        +string light
        +string note
        +boolean done
        +number ord
        +boolean fav
    }

    class ScheduleNode {
        +string id
        +string type
        +string title
        +string start
        +string end
        +string note
        +string date
        +boolean done
        +boolean fav
        +string auto
    }

    class Scene {
        +string id
        +string name
        +string note
        +boolean done
        +boolean fav
    }

    class DayPlan {
        +string date
        +number base
        +PlanShot[] shots
        +PlanNode[] nodes
        +Wrap wrap
        +boolean overflow
        +number shiftedCount
        +PlanShift[] nodeShifts
        +OverflowShot[] overflowShots
        +boolean overflowHard
    }

    class OverflowShot {
        +string id
        +string toDate
    }

    class PlanShift {
        +string id
        +number from
        +number to
    }

    class PlanShot {
        +string id
        +number start
        +number end
        +number duration
    }

    class PlanNode {
        +string id
        +number start
        +number end
        +string auto
    }

    class Wrap {
        +number start
        +number end
    }

    class NodeDefault {
        +string kind
        +string type
        +string title
        +string start
        +string end
        +string note
        +string auto
        +string id
    }

    Project "1" --> "0..*" Shot : shots
    Project "1" --> "0..*" ScheduleNode : schedule
    Project "1" --> "0..*" Scene : scenes
    Shot "0..*" --> "0..1" Scene : sceneId
    DayPlan "1" --> "0..*" PlanShot : shots
    DayPlan "1" --> "0..*" PlanNode : nodes
    DayPlan "1" --> "0..*" PlanShift : nodeShifts
    DayPlan "1" --> "0..*" OverflowShot : overflowShots
    DayPlan "1" --> "1" Wrap : wrap

    class ScheduleEngine {
        <<module>>
        +string DAY_BASE
        +string COLLECT_START
        +number COLLECT_MIN
        +number WRAP_MIN
        +number SHOT_DEFAULT_MIN
        +addDays(dateStr, n) string
        +normalizeShootDates(p) string[]
        +addShootDate(p, d) boolean
        +pinOf(n, defMin) Object
        +planDay(p, date, anchorId) DayPlan
        +dayDefaults(p, date) NodeDefault[]
        +ensureDayDefaults(p, date, mkId) number
        +rescheduleDay(p, date, anchorId) DayPlan
        +applyDay(p, date, anchorId) DayPlan
        +applyPlanWrite(p, date, plan) void
    }

    class TimeUtils {
        <<module>>
        +toMin(hhmm) number
        +fmtMin(min) string
        +addMin(hhmm, m) string
        +dayItems(p, date) Item[]
        +cascadeShift(p, date, id, delta) number
    }

    class RenderLayer {
        <<module>>
        +renderSchedule(p) void
        +dayTabsHtml(p) string
        +setSchedDate(d) void
        +confirmNewDay() void
        +removeShootDay(d) void
        +renderShots(p) void
        +renderShootDay() void
        +timelineHtml(p, date) string
        +callSheetHtml(p) string
        +addShot() void
        +saveShotEdit(id) void
        +delShot(id) void
        +persistOrder(list, draggedId) void
        +addNode() void
        +saveNodeEdit(id) void
        +delNode(id) void
        +sdPostpone() void
        +addSceneInline() void
        +autoSyncDay(date) void
        +toastResched(plan) void
    }

    ScheduleEngine ..> TimeUtils : 使用 toMin/fmtMin/addMin
    ScheduleEngine ..> Project : 读 shots/schedule/dayInit
    ScheduleEngine ..> DayPlan : 产出
    RenderLayer ..> ScheduleEngine : 每次写操作后重排
    RenderLayer ..> TimeUtils : dayItems 渲染时间轴
    RenderLayer ..> Project : updateCur 写守卫（demo 只读）
