{
  "name": "stillmark-shotflow-planner",
  "version": "10.7.1",
  "private": true,
  "type": "module",
  "description": "瞬刻摄影工作台 · Stillmark —— 本地优先摄影策划 PWA",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "lint": "eslint src scripts tests playwright.config.js eslint.config.js",
    "format:check": "prettier --check \"scripts/*.mjs\" \"eslint.config.js\" \"playwright.config.js\"",
    "test": "npm run test:logic && npm run test:e2e",
    "test:logic": "node tests/logic.test.mjs",
    "test:e2e": "playwright test",
    "test:perf": "node tests/perf.mjs",
    "sync": "node scripts/sync-app.mjs",
    "sync:check": "node scripts/sync-app.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=18"
  }
}
