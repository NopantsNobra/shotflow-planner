{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stillmark asset archive manifest v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "stillmark.asset-pack"
    },
    "containerVersion": {
      "const": 1
    },
    "dataVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "projects",
        "shots"
      ]
    },
    "exportedAt": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "data": {
      "type": "object",
      "properties": {
        "path": {
          "const": "data.json"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "path": {
            "type": "string",
            "pattern": "^images/[0-9a-f]{64}\\.(jpg|png|webp|gif|avif)$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mime": {
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp",
              "image/gif",
              "image/avif"
            ]
          }
        },
        "required": [
          "key",
          "path",
          "bytes",
          "sha256",
          "mime"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "containerVersion",
    "dataVersion",
    "kind",
    "exportedAt",
    "data",
    "images"
  ],
  "additionalProperties": false
}
