{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stillmark asset archive business data v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataVersion",
    "kind",
    "entries"
  ],
  "properties": {
    "dataVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "projects",
        "shots"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "client": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "studio": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "status": {
            "enum": [
              "灵感期",
              "策划中",
              "待拍摄",
              "后期中",
              "已交付",
              "已归档"
            ]
          },
          "location": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "lat": {
            "type": [
              "string",
              "number"
            ],
            "maxLength": 32
          },
          "lng": {
            "type": [
              "string",
              "number"
            ],
            "maxLength": 32
          },
          "timeZone": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "workspaceMode": {
            "enum": [
              "casual",
              "portrait",
              "professional",
              "custom"
            ]
          },
          "workspaceCustom": {
            "type": "array",
            "items": {
              "enum": [
                "concept",
                "mood",
                "shots",
                "schedule",
                "stuff",
                "budget",
                "notes"
              ]
            },
            "maxItems": 7
          },
          "v3": {
            "const": 1
          },
          "v9": {
            "type": "integer"
          },
          "demo": {
            "const": false
          },
          "assetPack": {
            "const": false
          },
          "createdAt": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "updatedAt": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "shootDate": {
            "type": "string",
            "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2})?$"
          },
          "shootDates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "maxItems": 3660
          },
          "dayInit": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "maxItems": 3660
          },
          "concept": {
            "type": "object",
            "properties": {
              "theme": {
                "type": "string",
                "maxLength": 200,
                "minLength": 0
              },
              "model": {
                "type": "string",
                "maxLength": 200,
                "minLength": 0
              },
              "style": {
                "type": "string",
                "maxLength": 200,
                "minLength": 0
              },
              "audience": {
                "type": "string",
                "maxLength": 200,
                "minLength": 0
              },
              "usage": {
                "type": "string",
                "maxLength": 200,
                "minLength": 0
              },
              "note": {
                "type": "string",
                "maxLength": 4000,
                "minLength": 0
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "tagVocab": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            },
            "maxItems": 5000
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2})?$"
                },
                "slot": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9])?$"
                },
                "duration": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 5,
                  "maximum": 1440
                },
                "sceneId": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 0
                },
                "refIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1
                  },
                  "maxItems": 3
                },
                "position": {
                  "type": "string",
                  "maxLength": 20,
                  "minLength": 0
                },
                "light": {
                  "type": "string",
                  "maxLength": 20,
                  "minLength": 0
                },
                "note": {
                  "type": "string",
                  "maxLength": 1000,
                  "minLength": 0
                },
                "done": {
                  "type": "boolean"
                },
                "mustShoot": {
                  "type": "boolean"
                },
                "skipped": {
                  "type": "boolean"
                },
                "deferred": {
                  "type": "boolean"
                },
                "ord": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "fav": {
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "maxLength": 1000,
                  "minLength": 0
                },
                "done": {
                  "type": "boolean"
                },
                "fav": {
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 0
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 120,
                    "minLength": 1
                  },
                  "maxItems": 5000
                },
                "createdAt": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "fav": {
                  "type": "boolean"
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          },
          "mood": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "text",
                    "color",
                    "image"
                  ]
                },
                "content": {
                  "type": "string",
                  "maxLength": 4000,
                  "minLength": 0
                },
                "tag": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 0
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 120,
                    "minLength": 1
                  },
                  "maxItems": 5000
                },
                "autoTags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 120,
                    "minLength": 1
                  },
                  "maxItems": 5000
                },
                "fav": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "content"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          },
          "schedule": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "maxLength": 20,
                  "minLength": 0
                },
                "title": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "start": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9])?$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^(?:[01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9])?$"
                },
                "note": {
                  "type": "string",
                  "maxLength": 1000,
                  "minLength": 0
                },
                "date": {
                  "type": "string",
                  "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2})?$"
                },
                "done": {
                  "type": "boolean"
                },
                "fav": {
                  "type": "boolean"
                },
                "timeLocked": {
                  "type": "boolean"
                },
                "auto": {
                  "enum": [
                    null,
                    "call",
                    "wrap"
                  ]
                }
              },
              "required": [
                "title"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "服装道具",
                    "器材"
                  ]
                },
                "name": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "maxLength": 500,
                  "minLength": 0
                },
                "done": {
                  "type": "boolean"
                },
                "fav": {
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          },
          "budget": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "item": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1
                },
                "cat": {
                  "type": "string",
                  "maxLength": 20,
                  "minLength": 0
                },
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 999999999
                },
                "paid": {
                  "type": "boolean"
                },
                "fav": {
                  "type": "boolean"
                }
              },
              "required": [
                "item"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "maxLength": 20,
                  "minLength": 0
                },
                "content": {
                  "type": "string",
                  "maxLength": 4000,
                  "minLength": 0
                },
                "ts": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "fav": {
                  "type": "boolean"
                }
              },
              "required": [
                "content"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          },
          "todos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "maxLength": 60,
                  "minLength": 0
                },
                "due": {
                  "type": "string",
                  "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2})?$"
                },
                "done": {
                  "type": "boolean"
                },
                "fav": {
                  "type": "boolean"
                }
              },
              "required": [
                "title"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    }
  }
}
